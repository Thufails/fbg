                        FROM data_report 
                        WHERE (LOWER(nama_akun) LIKE '%omzet bersih%' 
                            OR LOWER(nama_akun) LIKE '%omzetbersih%'
                            OR nama_akun = 'Omzet Bersih')";
                        
                        $paramsOmzetBersihBulananLain = [];
                        
