uasort($akunData, function($a, $b) use ($akunData, $urutanAkun) {
    // Cari nama akun untuk array $a dan $b
    $namaAkunA = null;
    $namaAkunB = null;
    
    foreach ($akunData as $nama => $data) {
        if ($data === $a) $namaAkunA = $nama;
        if ($data === $b) $namaAkunB = $nama;
        if ($namaAkunA && $namaAkunB) break;
    }
    
    $urutanA = isset($urutanAkun[$namaAkunA]) ? $urutanAkun[$namaAkunA] : 9999;
    $urutanB = isset($urutanAkun[$namaAkunB]) ? $urutanAkun[$namaAkunB] : 9999;
    
    return $urutanA - $urutanB;
});

