function simpanTabelKeDatabase($pdo, $kd_laporan, $nama_tabel, $data) {
    try {
        // Konversi array ke JSON
         // Cek apakah data sudah ada
        $sql_clean = "DELETE FROM hasil_analisis WHERE kd_laporan = ? AND title = ?";
        $stmt_clean = $pdo->prepare($sql_clean);
        $stmt_clean->execute([$kd_laporan, $nama_tabel]);
         //return "Data tabel '$nama_tabel' berhasil Dihapus";
        //////////////////////////////////////////////////////////////

        $json_data = json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE);
        
        // Cek apakah data sudah ada
        $sql_check = "SELECT kd_hasil_analisis FROM hasil_analisis 
                      WHERE kd_laporan = ? AND title = ?";
        $stmt_check = $pdo->prepare($sql_check);
        $stmt_check->execute([$kd_laporan, $nama_tabel]);
        $existing = $stmt_check->fetch(PDO::FETCH_ASSOC);
        
        if ($existing) {
            // Update data yang sudah ada
            $sql = "UPDATE hasil_analisis 
                    SET data = ?, 
                        updated_at = NOW()
                    WHERE kd_hasil_analisis = ?";
            $stmt = $pdo->prepare($sql);
            
            // Hitung ukuran data dan jumlah record
           // $ukuran_data = strlen($json_data);
           // $jumlah_record = is_array($data) && isset($data[0]) ? count($data) : 1;
            
            $stmt->execute([
                $json_data,
                $existing['kd_hasil_analisis']
            ]);
            
            return "Data tabel '$nama_tabel' berhasil diupdate";
        } else {
            // Insert data baru
            $sql = "INSERT INTO hasil_analisis 
                    (kd_laporan, title, data, created_at, updated_at)
                    VALUES (?, ?, ?, NOW(), NOW())";
            $stmt = $pdo->prepare($sql);
            
            // Hitung ukuran data dan jumlah record
            $ukuran_data = strlen($json_data);
            $jumlah_record = is_array($data) && isset($data[0]) ? count($data) : 1;
            
            $stmt->execute([
                $kd_laporan,
                $nama_tabel,
                $json_data
            ]);
            
            return "Data tabel '$nama_tabel' berhasil disimpan";
        }
    } catch (PDOException $e) {
        return "Error menyimpan tabel '$nama_tabel': " . $e->getMessage();
    }
}


function simpanSemuaTabelKeDatabase($pdo, $semuaTabel, $kd_laporan) {
    $results = [];
    
    foreach ($semuaTabel as $nama => $data) {
        $results[$nama] = simpanTabelKeDatabase($pdo, $kd_laporan, $nama, $data);
    }
    
    return $results;
}

