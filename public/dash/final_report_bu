            $entityTotalGap += $gap;
            $entityTotalAchievement += $achievementPercentage;
            $entityAccountCount++;
        }
        
        // Hitung summary entitas
        $entityData['summary']['total_target'] = $entityTotalTarget;
        $entityData['summary']['total_target_formatted'] = formatFullNumber($entityTotalTarget);
        $entityData['summary']['total_realization'] = $entityTotalRealization;
        $entityData['summary']['total_realization_formatted'] = formatFullNumber($entityTotalRealization);
        $entityData['summary']['total_gap'] = $entityTotalGap;
        $entityData['summary']['total_gap_formatted'] = formatFullNumber($entityTotalGap);
        $entityData['summary']['total_accounts'] = $entityAccountCount;
        
        // Tentukan gap status untuk entitas
        if ($entityTotalGap > 0) {
            $entityData['summary']['total_gap_status'] = 'positive';
        } elseif ($entityTotalGap < 0) {
            $entityData['summary']['total_gap_status'] = 'negative';
        } else {
            $entityData['summary']['total_gap_status'] = 'neutral';
        }
        
        // Hitung rata-rata pencapaian
        $entityAverageAchievement = $entityAccountCount > 0 ? $entityTotalAchievement / $entityAccountCount : 0;
        $entityData['summary']['average_achievement_percentage'] = $entityAverageAchievement;
        $entityData['summary']['average_achievement_formatted'] = number_format($entityAverageAchievement, 1) . '%';
        
        // Tambahkan entitas ke data utama
        $goalRealityPerEntitas['entities'][] = $entityData;
        
        // Akumulasi untuk overall summary
        $totalEntities++;
        $totalAccounts += $entityAccountCount;
        $grandTotalTarget += $entityTotalTarget;
        $grandTotalRealization += $entityTotalRealization;
        $grandTotalGap += $entityTotalGap;
    }
    
    // Hitung overall summary
    $goalRealityPerEntitas['overall_summary']['total_entities'] = $totalEntities;
    $goalRealityPerEntitas['overall_summary']['total_accounts'] = $totalAccounts;
    $goalRealityPerEntitas['overall_summary']['grand_total_target'] = $grandTotalTarget;
    $goalRealityPerEntitas['overall_summary']['grand_total_target_formatted'] = formatFullNumber($grandTotalTarget);
    $goalRealityPerEntitas['overall_summary']['grand_total_realization'] = $grandTotalRealization;
    $goalRealityPerEntitas['overall_summary']['grand_total_realization_formatted'] = formatFullNumber($grandTotalRealization);
    $goalRealityPerEntitas['overall_summary']['grand_total_gap'] = $grandTotalGap;
    $goalRealityPerEntitas['overall_summary']['grand_total_gap_formatted'] = formatFullNumber($grandTotalGap);
    
    // Tentukan gap status overall
    if ($grandTotalGap > 0) {
        $goalRealityPerEntitas['overall_summary']['grand_total_gap_status'] = 'positive';
    } elseif ($grandTotalGap < 0) {
        $goalRealityPerEntitas['overall_summary']['grand_total_gap_status'] = 'negative';
    } else {
        $goalRealityPerEntitas['overall_summary']['grand_total_gap_status'] = 'neutral';
    }
    
    // Hitung overall achievement percentage
    $overallAchievementPercentage = $grandTotalTarget > 0 ? ($grandTotalRealization / $grandTotalTarget) * 100 : 0;
    $goalRealityPerEntitas['overall_summary']['overall_achievement_percentage'] = $overallAchievementPercentage;
    $goalRealityPerEntitas['overall_summary']['overall_achievement_formatted'] = number_format($overallAchievementPercentage, 1) . '%';
    
} else {
    // Jika tidak ada data
    $goalRealityPerEntitas['status'] = 'no_data';
    $goalRealityPerEntitas['message'] = 'Tidak ada data entitas yang tersedia untuk periode yang dipilih';
}



